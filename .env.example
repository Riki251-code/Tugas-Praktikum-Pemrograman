# Supabase Configuration (Wajib untuk hosting online di Vercel / Netlify)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Session Cookie Signing Secret (ganti dengan string acak panjang di production)
AUTH_SESSION_SECRET=replace-with-a-long-random-secret-key-at-least-32-chars

